[PARAMETERS]
// Priors widened (v2) after boundary-check: cover ML region found in first round
1 G5N unif 1000000 5000000 output
1 G6N unif 20000 400000 output
1 G3N unif 20000 500000 output
1 G2N unif 100000 500000 output
1 G1N unif 100000 800000 output
1 TBOT_E unif 1000 20000 output
0 RES_G5 logunif 1 30 output
0 RES_G6 logunif 1 30 output
0 RES_G1 logunif 1 30 output
1 INC1_POSTBOT unif 3000 40000 output
0 MIG_G2_to_G3 logunif 1e-6 1e-4 output
1 INC2 unif 5000 50000 output
1 INC3 unif 20 2000 output
1 INC4 unif 50 5000 output

[COMPLEX PARAMETERS]
1 TIME1 = TBOT_E+INC1_POSTBOT output
1 TIME2 = TIME1+INC2 output
1 TIME3 = TIME2+INC3 output
1 TIME4 = TIME3+INC4 output
