// M28: independent-bottleneck-time variant of M02 (three-stage botr/recr; PNBOT=NX*botr, PAN=PNBOT*recr; per-deme onset TBOT_Gx and duration DURBOT_Gx; TIME1 anchored to TENDBOT_G5)
[PARAMETERS]
1 G5N unif 500 3000000 output
1 G6N unif 500 3000000 output
1 G3N unif 500 3000000 output
1 G2N unif 500 3000000 output
1 G1N unif 500 3000000 output
1 TBOT_G5 unif 10 2000 output
1 TBOT_G6 unif 10 2000 output
1 DURBOT_G5 unif 10 2000 output
1 DURBOT_G6 unif 10 2000 output
0 botr_G5 logunif 1e-3 9e-1 output
0 recr_G5 logunif 1.01 50 output
0 botr_G6 logunif 1e-3 9e-1 output
0 recr_G6 logunif 1.01 50 output
1 INC1_POSTBOT unif 10 100000 output
1 INC2 unif 10 100000 output
1 INC3 unif 10 100000 output
1 INC4 unif 10 100000 output

[COMPLEX PARAMETERS]
1 PNBOT_G5 = G5N*botr_G5 output
1 PNBOT_G6 = G6N*botr_G6 output
1 PAN_G5 = PNBOT_G5*recr_G5 output
1 PAN_G6 = PNBOT_G6*recr_G6 output
1 TENDBOT_G5 = TBOT_G5+DURBOT_G5 hide
1 TENDBOT_G6 = TBOT_G6+DURBOT_G6 hide
1 TIME1 = TENDBOT_G5+INC1_POSTBOT output
1 TIME2 = TIME1+INC2 output
1 TIME3 = TIME2+INC3 output
1 TIME4 = TIME3+INC4 output
