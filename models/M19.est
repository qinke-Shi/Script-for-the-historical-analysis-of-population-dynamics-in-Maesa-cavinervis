[PARAMETERS]
1 G5N unif 1000000 5000000 output
1 G6N unif 20000 200000 output
1 G3N unif 50000 400000 output
1 G2N unif 100000 500000 output
1 G1N unif 300000 1200000 output
1 TBOT_E unif 500 3000 output
0 RES_G5 logunif 1 10 output
0 RES_G6 logunif 1 10 output
0 RES_G1 logunif 1 10 output
1 INC1_POSTBOT unif 2000 8000 output
0 MIG_G2_to_G3 logunif 1e-5 1e-3 output
0 MIG_G3_to_G2 logunif 1e-5 1e-3 output
1 INC2 unif 10000 30000 output
1 INC3 unif 50 1000 output
1 INC4 unif 100 2000 output

[COMPLEX PARAMETERS]
1 TIME1 = TBOT_E+INC1_POSTBOT output
1 TIME2 = TIME1+INC2 output
1 TIME3 = TIME2+INC3 output
1 TIME4 = TIME3+INC4 output
